    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## 3. Time-based cross-validation\",\n",
    "   \"id\": \"c3a951940ee7bfaa\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-10T14:16:29.507113Z\",\n",
    "     \"start_time\": \"2026-01-10T14:16:29.503962Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# fixed training set size\\n\",\n",
    "    \"tss = TimeSeriesSplit(n_splits=5,gap=24*2,max_train_size=24 * 365,test_size=24*30)\"\n",
    "   ],\n",
    "   \"id\": \"a6e290f9b136353\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 8\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## 4. Model Evaluation\",\n",
    "   \"id\": \"a701710740d9d654\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-10T14:16:29.519352Z\",\n",
    "     \"start_time\": \"2026-01-10T14:16:29.515348Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# model evaluation\\n\",\n",
    "    \"def evaluate(model, X, y):\\n\",\n",
    "    \"    ret = cross_validate(model, X, y, cv=tss, scoring=[\\\"neg_root_mean_squared_error\\\"])\\n\",\n",
    "    \"    rmse = -ret[\\\"test_neg_root_mean_squared_error\\\"]\\n\",\n",
    "    \"    print(\\\"%.2f ± %.2f\\\" % (rmse.mean(), rmse.std()))\"\n",
    "   ],\n",
    "   \"id\": \"f941ce2e8aa53961\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 9\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
