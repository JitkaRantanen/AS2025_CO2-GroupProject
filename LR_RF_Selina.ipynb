    "     \"start_time\": \"2026-01-10T14:16:29.539889Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"X_tri = df_train_X[tri_cols + scaled_cols]\\n\",\n",
    "    \"X_spl = df_train_X[spline_cols + scaled_cols]\"\n",
