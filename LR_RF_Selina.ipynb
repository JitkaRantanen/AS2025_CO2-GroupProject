    "    \"encoded_cols = list(df_train_X.filter(like=\\\"encoded_\\\").columns)\\n\",\n",
    "    \"tri_cols = list(df_train_X.iloc[:,0:8].columns)\"\n",
    "   ],\n",
    "   \"id\": \"c0f506daf5af5154\",\n",
    "   \"outputs\": [],\n",
